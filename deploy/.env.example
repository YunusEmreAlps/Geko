# DNS for this name must point at the server before Caddy can obtain a certificate.
GEKO_DOMAIN=geko.example.com

# Published image tag, such as 0.1.0. Defaults to latest.
# GEKO_VERSION=0.1.0

# Dashboard password (user: geko) and full API access. Generate: openssl rand -hex 32
GEKO_ACCESS_TOKEN=

# One export-only token per application: name=token, comma-separated.
# Generate each token with: openssl rand -hex 32
GEKO_INGEST_TOKENS=

# Read-only tokens for coding agents (/mcp), scripts and teammates: name=token pairs.
GEKO_READ_TOKENS=

# Tokens that also resolve, mute and reopen error groups, for QA and on-call:
# name=token pairs. The name is recorded as who changed a group.
GEKO_TRIAGE_TOKENS=

# Optional: Slack, Discord, ntfy or JSON webhook for new and reopened error groups.
GEKO_WEBHOOK_URL=

# strict (default here) or best_effort; see docs/configuration.md#privacy.
# GEKO_REDACTION=strict

# Optional: sign in through oauth2-proxy or another authenticating proxy that
# sets a user header. See docs/server.md#sign-in-through-a-proxy.
# GEKO_PROXY_USER_HEADER=X-Auth-Request-Email
# GEKO_PROXY_TRUSTED_IPS=172.16.0.0/12
# GEKO_PROXY_ROLES=alice@example.com=admin,qa@example.com=triager
# GEKO_PROXY_DEFAULT_ROLE=viewer

# GEKO_RETENTION_DAYS=14
# GEKO_MAX_DB_MIB=4096
