# DNS for this name must point at the server before Caddy can obtain a certificate.
GEKO_DOMAIN=geko.example.com

# Dashboard password (user: geko) and full API access. Generate: openssl rand -hex 32
GEKO_ACCESS_TOKEN=

# One export-only token per application: name=token, comma-separated.
# Generate each token with: openssl rand -hex 32
GEKO_INGEST_TOKENS=

# Read-only tokens for coding agents (/mcp), scripts and teammates: name=token pairs.
GEKO_READ_TOKENS=

# Optional: Slack, Discord, ntfy or JSON webhook for new and reopened error groups.
GEKO_WEBHOOK_URL=

# GEKO_RETENTION_DAYS=14
# GEKO_MAX_DB_MIB=4096
